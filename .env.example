

# Copy to .env and provide credentials from a dedicated, read-only lab account.
# Never commit a populated .env file.
GROQ_API_KEY=your_key_here

MISP_URL=https://localhost
MISP_API_KEY=
MISP_VERIFY_SSL=true

# Email delivery requires explicit lab recipient allowlisting.
SOC_EMAIL=
SOC_EMAIL_ALLOWLIST=
MEDFLOW_EMAIL_MIN_SEVERITY=8
MEDFLOW_EMAIL_MAX_EVIDENCE_AGE_MINUTES=15
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Wazuh Manager API and/or Wazuh Indexer (leave unused endpoint credentials empty).
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_ALERTS_PATH=/alerts
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=replace_with_unique_dashboard_password
WAZUH_VERIFY_TLS=true
WAZUH_CA_BUNDLE=
MEDFLOW_WAZUH_INDEXER_USER=
MEDFLOW_WAZUH_INDEXER_PASSWORD=
WAZUH_API_TIMEOUT=10
WAZUH_MAX_RETRIES=2
WAZUH_PAGE_SIZE=100
WAZUH_MAX_PAGES=10
WAZUH_RECENT_HOURS=24
WAZUH_LOOKBACK_DAYS=7
WAZUH_CHECKPOINT_PATH=data/collector-checkpoints/wazuh.json

# Suricata EVE JSONL file and checkpoint. SURICATA_SENSOR_ID is optional.
SURICATA_EVE_PATH=/app/suricata/lab-logs/eve.json
MEDFLOW_MAX_LIVE_ALERTS_PER_INVESTIGATION=100
MEDFLOW_MAX_LIVE_EVENT_AGE_DAYS=365
SURICATA_SENSOR_ID=
SURICATA_CHECKPOINT_PATH=data/collector-checkpoints/suricata.json
