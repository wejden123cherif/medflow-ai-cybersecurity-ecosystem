# ==============================================================
# MedFlow AI - Suricata Local Custom Rules
# ==============================================================
# Format: action proto src_ip src_port direction dst_ip dst_port (options)
# ==============================================================

# -------------------------------------------------------
# [TEST] Detect ICMP ping — simple connectivity test rule
# -------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"MEDFLOW-TEST ICMP Ping Detected"; itype:8; classtype:misc-activity; sid:9000001; rev:1;)

# -------------------------------------------------------
# [T1046] Network Service Scanning — Nmap-style port sweep
# -------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"MEDFLOW T1046 Network Service Scanning Attempt"; flags:S; threshold:type both,track by_src,count 20,seconds 5; classtype:network-scan; sid:9000002; rev:1;)

# -------------------------------------------------------
# [T1110] Brute Force — High frequency SSH login attempts
# -------------------------------------------------------
alert tcp any any -> $HOME_NET 22 (msg:"MEDFLOW T1110 SSH Brute Force Attempt"; flow:to_server,established; content:"SSH"; threshold:type both,track by_src,count 10,seconds 60; classtype:attempted-admin; sid:9000003; rev:1;)

# -------------------------------------------------------
# [T1110.001] Brute Force — RDP password spray
# -------------------------------------------------------
alert tcp any any -> $HOME_NET 3389 (msg:"MEDFLOW T1110.001 RDP Brute Force Detected"; flags:S; threshold:type both,track by_src,count 5,seconds 60; classtype:attempted-admin; sid:9000004; rev:1;)

# -------------------------------------------------------
# [T1071.001] Application Layer Protocol — Suspicious HTTP UA
# -------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"MEDFLOW T1071.001 Suspicious User-Agent Detected"; http.user_agent; content:"python-requests"; nocase; classtype:policy-violation; sid:9000005; rev:1;)

# -------------------------------------------------------
# [T1041] Exfiltration over C2 Channel — Large outbound data
# -------------------------------------------------------
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MEDFLOW T1041 Possible Data Exfiltration - Large Outbound Transfer"; dsize:>4096; flow:to_server,established; threshold:type both,track by_src,count 10,seconds 30; classtype:trojan-activity; sid:9000006; rev:1;)

# -------------------------------------------------------
# [T1190] Exploit Public-Facing App — SQL injection attempt
# -------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"MEDFLOW T1190 SQL Injection Attempt Detected"; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:9000007; rev:1;)

# -------------------------------------------------------
# [T1059] Command and Scripting Interpreter — Suspicious cmd
# -------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"MEDFLOW T1059 Possible Remote Code Execution via HTTP"; http.uri; content:"/cmd="; nocase; classtype:web-application-attack; sid:9000008; rev:1;)

# -------------------------------------------------------
# [T1071.004] DNS tunneling — High-entropy DNS query
# -------------------------------------------------------
alert dns any any -> any 53 (msg:"MEDFLOW T1071.004 Possible DNS Tunneling - Long Query Detected"; dns.query; byte_test:1,>,50,0,string,dec; classtype:policy-violation; sid:9000009; rev:1;)

# -------------------------------------------------------
# [T1498] Network DoS — UDP flood detection
# -------------------------------------------------------
alert udp any any -> $HOME_NET any (msg:"MEDFLOW T1498 UDP Flood DoS Attack"; threshold:type both,track by_src,count 1000,seconds 5; classtype:denial-of-service; sid:9000010; rev:1;)

# -------------------------------------------------------
# [Auto-Drop] Dynamically added rules by MedFlow Response Engine
# Rules below this line are auto-generated at runtime
# -------------------------------------------------------

drop ip 192.168.1.100 any -> any any (msg:"MedFlow Auto-Drop 192.168.1.100"; sid:9149409; rev:1;)

